{
  // Static-assets-only Worker. Declaring `assets` explicitly stops wrangler
  // from auto-detecting the framework and demanding the Cloudflare Vite
  // plugin (which needs Vite >= 6) — this site is a plain static build.
  //
  // `name` MUST match the Worker that owns srigunting.id, which is
  // "srigunting-ops". Wrangler deploys to whatever name is written here, so
  // a mismatch silently creates a second Worker and leaves the live domain
  // serving the old build.
  "name": "srigunting-ops",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist"
  }
}
